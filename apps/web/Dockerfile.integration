FROM node:22-alpine AS build
WORKDIR /app/apps/web
COPY apps/web/package*.json ./
RUN npm ci
COPY apps/web/tsconfig.json apps/web/vite.config.ts apps/web/index.html ./
COPY apps/web/src ./src
COPY apps/api/src/digifort/municipal-code-parser.ts /app/apps/api/src/digifort/municipal-code-parser.ts
COPY apps/api/src/digifort/json-types.ts /app/apps/api/src/digifort/json-types.ts
COPY apps/api/src/digifort/collection-types.ts /app/apps/api/src/digifort/collection-types.ts
COPY apps/api/src/live/types.ts /app/apps/api/src/live/types.ts
RUN npm run build
FROM nginx:1.27-alpine
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
